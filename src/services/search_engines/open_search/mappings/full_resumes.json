{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "knn": true
    },
    "analysis": {
      "filter": {
        "ru_stop": {"type": "stop", "stopwords": "_russian_"},
        "ru_stemmer": {"type": "stemmer", "language": "russian"},
        "en_stemmer": {"type": "stemmer", "language": "english"}
      },
      "analyzer": {
        "ru_en": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "ru_stop", "ru_stemmer", "en_stemmer"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": false,

    "properties": {
      "id": {"type": "keyword"},
      "source": {"type": "keyword"},
      "real_id": {"type": "keyword"},
      "alternate_url": {"type": "keyword", "index": false},

      "full_text": {"type": "text", "analyzer": "ru_en"},

      "title": {
        "type": "text",
        "analyzer": "ru_en",
        "copy_to": "full_text",
        "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
      },

      "first_name": {"type": "text", "analyzer": "ru_en"},
      "last_name": {"type": "text", "analyzer": "ru_en"},
      "middle_name": {"type": "text", "analyzer": "ru_en"},

      "age": {"type": "integer"},
      "birth_date": {"type": "date", "format": "strict_date_optional_time"},
      "gender": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "created_at": {"type": "date", "format": "yyyy-MM-dd'T'HH:mm:ssZ||strict_date_optional_time_nanos||epoch_millis"},
      "updated_at": {"type": "date", "format": "yyyy-MM-dd'T'HH:mm:ssZ||strict_date_optional_time_nanos||epoch_millis"},

      "area": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "citizenship": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "work_ticket": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "salary": {
        "properties": {
          "amount": {"type": "long"},
          "currency": {"type": "keyword"}
        }
      },

      "total_experience": {
        "properties": {
          "months": {"type": "integer"}
        }
      },

      "tenure": {
        "properties": {
          "job_count": {"type": "integer"},
          "average_months": {"type": "integer"},
          "median_months": {"type": "integer"},
          "weighted_months": {"type": "integer"},
          "min_months": {"type": "integer"},
          "longest_months": {"type": "integer"},
          "last_months": {"type": "integer"},
          "jobs_under_year": {"type": "integer"}
        }
      },

      "last_job": {
        "properties": {
          "position": {
            "type": "text",
            "analyzer": "ru_en",
            "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
          },
          "company": {
            "type": "text",
            "analyzer": "ru_en",
            "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
          },
          "start": {"type": "date", "format": "strict_date_optional_time"},
          "end": {"type": "date", "format": "strict_date_optional_time"},
          "duration_months": {"type": "integer"},
          "is_current": {"type": "boolean"},
          "industry_ids": {"type": "keyword"}
        }
      },

      "company_ids": {"type": "keyword"},
      "company_keys": {"type": "keyword"},
      "industry_ids": {"type": "keyword"},

      "platform": {
        "properties": {
          "id": {"type": "keyword"}
        }
      },

      "resume_locale": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "skills": {
        "type": "text",
        "analyzer": "ru_en",
        "copy_to": "full_text"
      },

      "skill_set": {
        "type": "text",
        "analyzer": "ru_en",
        "copy_to": "full_text",
        "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
      },

      "language": {
        "type": "nested",
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"},
          "level": {
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "keyword"}
            }
          }
        }
      },

      "professional_roles": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {
            "type": "text",
            "analyzer": "ru_en",
            "copy_to": "full_text",
            "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
          }
