          "name": {"type": "keyword"}
        }
      },
      "employment_form": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "work_format": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "schedule": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },
      "schedules": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "relocation": {
        "properties": {
          "type": {
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "keyword"}
            }
          },
          "area": {
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "keyword"}
            }
          }
        }
      },

      "business_trip_readiness": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "travel_time": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"}
        }
      },

      "driver_license_types": {
        "properties": {
          "id": {"type": "keyword"}
        }
      },

      "has_vehicle": {"type": "boolean"},
      "has_medical_book": {"type": "boolean"},
      "has_self_employment": {"type": "boolean"},

      "metro": {
        "properties": {
          "id": {"type": "keyword"},
          "name": {"type": "keyword"},
          "line": {
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "keyword"}
            }
          }
        }
      },

      "education": {
        "properties": {
          "level": {
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "keyword"}
            }
          },
          "primary": {
            "type": "nested",
            "properties": {
              "id": {"type": "keyword"},
              "name": {
                "type": "text",
                "analyzer": "ru_en",
                "copy_to": "full_text",
                "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
              },
              "organization": {"type": "text", "analyzer": "ru_en", "copy_to": "full_text"},
              "result": {"type": "text", "analyzer": "ru_en"},
              "university_acronym": {"type": "keyword"},
              "year": {"type": "integer"},
              "education_level": {
                "properties": {
