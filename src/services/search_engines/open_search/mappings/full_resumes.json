                }
              }
            }
          },
          "additional": {
            "type": "nested",
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "text", "analyzer": "ru_en", "copy_to": "full_text"},
              "organization": {"type": "text", "analyzer": "ru_en", "copy_to": "full_text"},
              "result": {"type": "text", "analyzer": "ru_en"},
              "year": {"type": "integer"}
            }
          },
          "attestation": {
            "type": "nested",
            "properties": {
              "id": {"type": "keyword"},
              "name": {"type": "text", "analyzer": "ru_en", "copy_to": "full_text"},
              "organization": {"type": "text", "analyzer": "ru_en", "copy_to": "full_text"},
              "result": {"type": "text", "analyzer": "ru_en"},
              "year": {"type": "integer"}
            }
          }
        }
      },

      "experience": {
        "type": "nested",
        "properties": {
          "id": {"type": "keyword"},
          "start": {"type": "date", "format": "strict_date_optional_time"},
          "end": {"type": "date", "format": "strict_date_optional_time"},
          "duration_months": {"type": "integer"},
          "position": {
            "type": "text",
            "analyzer": "ru_en",
            "copy_to": "full_text",
            "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
          },
          "company": {
            "type": "text",
            "analyzer": "ru_en",
            "copy_to": "full_text",
            "fields": {"raw": {"type": "keyword", "ignore_above": 256}}
          },
          "company_id": {"type": "keyword"},
          "company_key": {"type": "keyword"},
          "company_url": {"type": "keyword", "index": false},

          "description": {
            "type": "text",
            "analyzer": "ru_en",
            "copy_to": "full_text"
          },

          "head_vector": {
            "type": "knn_vector",
            "dimension": 1536,
            "method": {
              "name": "hnsw",
              "engine": "lucene",
              "space_type": "cosinesimil",
              "parameters": {"ef_construction": 128, "m": 16}
            }
          },

          "description_chunks": {
            "type": "nested",
            "properties": {
              "order": {"type": "integer"},
              "text": {"type": "text", "analyzer": "ru_en"},
              "vector": {
                "type": "knn_vector",
                "dimension": 1536,
                "method": {
                  "name": "hnsw",
                  "engine": "lucene",
                  "space_type": "cosinesimil",
                  "parameters": {"ef_construction": 128, "m": 16}
                }
