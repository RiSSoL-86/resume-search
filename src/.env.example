# --- Base ---
SECRET_KEY=dev-only-change-me-to-a-random-32-character-secret-key
DEBUG=true
ENVIRONMENT=local
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
SCRIPT_NAME=
SITE_URL=http://localhost:8000
PROJECT_NAME='Django-DMR'

# --- Database (PostgreSQL) ---
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Cache (Redis) ---
CACHE_LOCATION=redis://localhost:6379/1

# --- Celery (Redis broker) ---
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=3600
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_POLLING_INTERVAL=1

# --- Timezone / i18n ---
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL='Partner Scout <noreply@example.com>'

# --- Storage ---
STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=cdn/media/
STATIC_ROOT=cdn/static/

# --- Sentry ---
SENTRY_DSN=
SENTRY_AUTO_SESSION_TRACKING=false
SENTRY_TRACES_SAMPLE_RATE=0

# --- OpenSearch ---
OPENSEARCH_HOSTS=http://localhost:9200

# --- OpenAI (requirement parsing + query embedding) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_LLM_MODEL=gpt-4.1
